# Pooled Postgres connection (keep the limits below)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=3&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Optional: leave blank on localhost / *.vercel.app (resolved dynamically)
NEXT_PUBLIC_SITE_URL=
# Admin session signing secret (change in production)
ADMIN_SESSION_SECRET="change-me-long-random-string"
# Optional admin overrides (defaults: admin@awan.local / 0929491004)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional Supabase Storage for image uploads (bucket must be public)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET="awan-media"
