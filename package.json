{
  "name": "awan-interiors",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:rls": "prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
